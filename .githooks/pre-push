#!/bin/bash
# The gate that runs before anything reaches main, because hosted CI cannot be
# relied on here.
#
# WHY THIS EXISTS. GitHub Actions on this repository has been blocked at the
# billing layer since 2026-08-10: every run fails in about four seconds without
# starting. Before that it was running and RED, and the dashboard redesign
# merged with five genuinely failing e2e specs that nobody saw for days. They
# were fixed by luck rather than by process. This hook is the process.
#
# WHAT IT DOES NOT NEED TO COVER. Content published from /edit never passes
# through here -- it becomes a commit via the GitHub API, from Bani's browser.
# That path is already gated twice: validateContent refuses a bad write inside
# the Worker before the commit exists, and the Cloudflare Pages build runs
# `npm run test:deploy` (the whole vitest suite) before the site goes live. So
# the only changes this hook has to catch are CODE pushes, and every one of
# those originates on a machine that can run this.
#
# Skip in a genuine emergency with: git push --no-verify
# If you do that, say so out loud to someone. That is the entire safety net.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

RED=$'\033[31m'; GREEN=$'\033[32m'; DIM=$'\033[2m'; OFF=$'\033[0m'
fail() { echo "${RED}✗ $1${OFF}"; echo "${DIM}  push aborted. fix, or re-run with --no-verify if you truly must.${OFF}"; exit 1; }
step() { echo "${DIM}→ $1${OFF}"; }

# Which files are actually being pushed. Used only to decide whether the slow
# browser suite is worth running -- never to skip the fast checks, which always
# run because they cost seconds.
RANGE="origin/$(git rev-parse --abbrev-ref HEAD)..HEAD"
CHANGED=$(git diff --name-only $RANGE 2>/dev/null || git diff --name-only HEAD~1..HEAD 2>/dev/null || echo "")

# Before anything else, for the same reason .github/workflows/e2e.yml runs it
# first: the public/ derivatives are gitignored, so a fresh clone has none and
# 48 asset specs fail on a checkout that did nothing wrong. Cheap on a machine
# that already has them, since it only generates what is missing.
step "image derivatives (gitignored, so a fresh clone has none)"
npm run images >/dev/null 2>&1 || fail "image generation failed"

step "typecheck (tsc -b, the only form that checks anything here)"
npx tsc -b --noEmit || fail "typecheck failed"

step "lint"
npx eslint . || fail "eslint failed"

step "unit + integration tests"
npm test -- --run || fail "tests failed"

# The SAME suite again, under the exact command Cloudflare Pages runs, and
# this step is here because of a real escape too.
#
# `npm run test:deploy` is `vitest run` minus two files. Dropping two files
# does not only drop their assertions -- it repacks every REMAINING file
# across Vitest's workers, so the same test lands on a differently-loaded
# core. src/admin/__tests__/AdminApp.test.tsx's "Add a coming-soon item" case
# passed `npm test` on every run and TIMED OUT at 5s under `test:deploy`,
# deterministically, on the machine that pushed it. `npm test -- --run` was
# green, the push was allowed, and Cloudflare refused the build.
#
# So this is not a duplicate of the step above and must not be collapsed into
# it. `npm test` is the wider net (it alone runs homepage-bytes and the image
# derivatives, deliberately excluded from the deploy gate -- see
# src/test/hosting.test.ts for why). `test:deploy` is the FAITHFUL one: it is
# literally what decides whether the site can deploy. Both, or neither is
# enough.
step "the same suite under the deploy's own command (different worker packing)"
npm run test:deploy || fail "test:deploy failed -- this is what Cloudflare runs. npm test passing does not cover it."

# The production build itself, unconditionally, and this step is here because
# of a real escape. src/test/bundle.post-build.test.ts's CSS ceiling is
# `it.skipIf(!existsSync('dist/assets'))`: with no dist/ on disk it does not
# fail, it SKIPS, and a skip reads as green. Phase 3 ran tsc + eslint +
# vitest + playwright on every one of eleven commits, never ran the build,
# and shipped a branch whose `npm run build` exited 1 -- which is also the
# documented Cloudflare Pages build command and CI's own test:csp step. There
# was no path to production through it and nothing said so for eight tasks.
#
# It cannot ride on the browser-suite block below: that block is skipped for
# any push that does not touch the paths it watches, and it is gated on
# Playwright browsers being installed. Neither has anything to do with
# whether the site can be built. `npm run build` also runs `npm run images`
# and `tsc -b` again, which costs a few seconds on a machine that has both
# already and buys back the entire class of failure above.
step "production build (this is what Cloudflare Pages runs)"
npm run build >/dev/null 2>&1 || fail "npm run build failed -- run it directly to see why. this is the deploy command."

# The browser suite is ~2 minutes, so it runs only when something it can
# actually observe has changed. Docs-only and content-only pushes skip it;
# anything touching src/, e2e/, index.html, the headers or the build config
# runs it. When in doubt the pattern errs toward running.
if echo "$CHANGED" | grep -qE '^(src/|e2e/|index\.html|public/_headers|public/_redirects|vite\.config|playwright\.config|package(-lock)?\.json)'; then
  if [ -d "$HOME/Library/Caches/ms-playwright" ] || [ -d "$HOME/.cache/ms-playwright" ]; then
    step "browser tests (e2e, both breakpoints)"
    npm run test:e2e || fail "e2e failed"
    step "content-security-policy against the production bundle"
    npm run test:csp || fail "csp check failed"
  else
    echo "${RED}! Playwright browsers are not installed, so the browser suite was SKIPPED.${OFF}"
    echo "${DIM}  Install with: npx playwright install chromium${OFF}"
    echo "${DIM}  Refusing to pretend this was a full gate.${OFF}"
    exit 1
  fi
else
  step "browser tests skipped (nothing changed that they can observe)"
fi

echo "${GREEN}✓ gate passed${OFF}"
