# Wrangler's local dev/state cache (`wrangler dev`), never committed -- same
# category as node_modules/dist above.
.wrangler

# Wrangler's local-secrets file (ADMIN_PASSWORD_HASH, TOKEN_SECRET, etc. for
# `wrangler dev`). Real secrets are set with `wrangler secret put`, never
# committed to this repo -- see src/test/secrets.test.ts.
.dev.vars
.dev.vars.*

# Source design assets (Illustrator packages, print PDFs) — too large for git
New Menu/

# Generated from assets-source/ by `npm run images`. `/public/*/` ignores
# every directory directly under public/ -- not just today's seven category
# names -- so a new assets-source/<category>/ that Task 6's upload route
# adds never needs a matching .gitignore edit. `!/public/menus/` carves the
# one loose, hand-committed exception back out (menus/ isn't generated from
# assets-source/ at all). `/public/**/*.webp` looks tempting but does NOT
# work here: it leaves the directories themselves unignored, so an empty
# `public/hero/` would still show up as untracked in a fresh clone.
/public/*/
!/public/menus/
/public/og-image.jpg

