{
  "name": "via-bianca-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run images && tsc -b && vite build && npm run test:bundle",
    "lint": "eslint .",
    "test": "vitest run",
    "test:deploy": "vitest run --exclude scripts/__tests__/images.derivatives.test.mjs --exclude src/test/homepage-bytes.test.tsx",
    "test:bundle": "VB_REQUIRE_DIST=1 vitest run src/test/bundle.post-build.test.ts src/test/crawlers.test.ts worker/__tests__/post-shell.dist.test.ts",
    "test:watch": "vitest",
    "preview": "vite preview",
    "images": "node scripts/images.mjs",
    "images:inventory": "node scripts/image-inventory.mjs",
    "test:e2e": "playwright test",
    "test:csp": "npm run build --silent && node scripts/check-csp.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "gate": "npm run images && npx tsc -b --noEmit && npx eslint . && npm test -- --run && npm run test:deploy && npm run build"
  },
  "dependencies": {
    "heic-to": "^1.5.2",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.118.0"
  }
}
